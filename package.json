{
  "name": "replace-on-save",
  "publisher": "EduardoDevop",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/eduardodevop/vscode-replace-on-save.git"
  },
  "displayName": "Replace On Save",
  "description": "Run a search and replace before saving a file, it also supports REGEX",
  "version": "2.1.0",
  "engines": {
    "vscode": "^1.52.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Replace On Save",
      "properties": {
        "replaceOnSave.enabled": {
          "type": "boolean"
        },
        "replaceOnSave.replacements": {
          "type": "array"
        }
      }
    },
    "commands": []
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "npm esbuild.js",
    "package": "npm run compile && vsce package",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts"
  },
  "dependencies": {
    "minimatch": "^10.1.1"
  },
  "devDependencies": {
    "@types/node": "^12.11.7",
    "@types/vscode": "^1.52.0",
    "@typescript-eslint/eslint-plugin": "^4.9.0",
    "@typescript-eslint/parser": "^4.9.0",
    "esbuild": "^0.27.2",
    "eslint": "^7.15.0",
    "typescript": "^5.9.0",
    "vscode-test": "^1.4.1"
  }
}
